import customtkinter as ctk
import sqlite3
from tkinter import ttk, messagebox


# ================= DATABASE =================

conn = sqlite3.connect("hospital.db")
cursor = conn.cursor()


def setup_database():

    cursor.execute("""
    CREATE TABLE IF NOT EXISTS users(
        id INTEGER PRIMARY KEY,
        username TEXT UNIQUE,
        password TEXT,
        role TEXT
    )
    """)

    cursor.execute("""
    CREATE TABLE IF NOT EXISTS patients(
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT,
        age TEXT,
        gender TEXT,
        phone TEXT
    )
    """)

    cursor.execute("""
    CREATE TABLE IF NOT EXISTS doctors(
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT,
        department TEXT
    )
    """)

    cursor.execute("""
    CREATE TABLE IF NOT EXISTS appointments(
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        patient TEXT,
        doctor TEXT,
        date TEXT
    )
    """)


    cursor.execute("""
    INSERT OR IGNORE INTO users
    VALUES(1,'admin','1234','Administrator')
    """)

    conn.commit()



# ================= LOGIN =================


class Login(ctk.CTk):

    def __init__(self):

        super().__init__()

        self.title("Hospital Login")
        self.geometry("400x350")


        ctk.CTkLabel(
            self,
            text="🏥 Hospital Management",
            font=("Arial",22,"bold")
        ).pack(pady=30)


        self.username=ctk.CTkEntry(
            self,
            placeholder_text="Username"
        )

        self.username.pack(pady=10)


        self.password=ctk.CTkEntry(
            self,
            placeholder_text="Password",
            show="*"
        )

        self.password.pack(pady=10)


        ctk.CTkButton(
            self,
            text="Login",
            command=self.login
        ).pack(pady=20)



    def login(self):

        cursor.execute(
            """
            SELECT role FROM users
            WHERE username=? AND password=?
            """,
            (
                self.username.get(),
                self.password.get()
            )
        )


        result=cursor.fetchone()


        if result:

            self.destroy()

            app=Dashboard(result[0])

            app.mainloop()


        else:

            messagebox.showerror(
                "Error",
                "Invalid Login"
            )



# ================= DASHBOARD =================


class Dashboard(ctk.CTk):


    def __init__(self,role):

        super().__init__()

        self.title(
            "Hospital Dashboard"
        )

        self.geometry(
            "1000x600"
        )


        ctk.set_appearance_mode(
            "dark"
        )


        # Sidebar

        sidebar=ctk.CTkFrame(
            self,
            width=200
        )

        sidebar.pack(
            side="left",
            fill="y"
        )


        ctk.CTkLabel(
            sidebar,
            text="Hospital System",
            font=("Arial",18,"bold")
        ).pack(pady=20)



        buttons=[

            ("Patients",self.patients),

            ("Doctors",self.doctors),

            ("Appointments",self.appointments),

            ("Reports",self.reports)

        ]


        for text,command in buttons:

            ctk.CTkButton(
                sidebar,
                text=text,
                command=command
            ).pack(
                pady=10,
                padx=20
            )


        self.main=ctk.CTkFrame(self)

        self.main.pack(
            expand=True,
            fill="both",
            padx=20,
            pady=20
        )


        ctk.CTkLabel(
            self.main,
            text=f"Welcome {role}",
            font=("Arial",30)
        ).pack(pady=50)



    # ================= PATIENTS =================


    def patients(self):

        self.clear()


        ctk.CTkLabel(
            self.main,
            text="Patient Management",
            font=("Arial",25)
        ).pack()


        name=ctk.CTkEntry(
            self.main,
            placeholder_text="Name"
        )

        age=ctk.CTkEntry(
            self.main,
            placeholder_text="Age"
        )

        gender=ctk.CTkEntry(
            self.main,
            placeholder_text="Gender"
        )

        phone=ctk.CTkEntry(
            self.main,
            placeholder_text="Phone"
        )


        for e in [name,age,gender,phone]:
            e.pack(pady=5)



        def save():

            cursor.execute(
                """
                INSERT INTO patients
                VALUES(NULL,?,?,?,?)
                """,
                (
                    name.get(),
                    age.get(),
                    gender.get(),
                    phone.get()
                )
            )

            conn.commit()

            messagebox.showinfo(
                "Success",
                "Patient Added"
            )


        ctk.CTkButton(
            self.main,
            text="Save",
            command=save
        ).pack(pady=10)




    # ================= DOCTORS =================


    def doctors(self):

        self.clear()


        title=ctk.CTkLabel(
            self.main,
            text="Doctors",
            font=("Arial",25)
        )

        title.pack()


        name=ctk.CTkEntry(
            self.main,
            placeholder_text="Doctor Name"
        )

        dep=ctk.CTkEntry(
            self.main,
            placeholder_text="Department"
        )


        name.pack(pady=5)
        dep.pack(pady=5)



        def save():

            cursor.execute(
                """
                INSERT INTO doctors
                VALUES(NULL,?,?)
                """,
                (
                    name.get(),
                    dep.get()
                )
            )

            conn.commit()


            messagebox.showinfo(
                "Saved",
                "Doctor Added"
            )


        ctk.CTkButton(
            self.main,
            text="Save",
            command=save
        ).pack()



    # ================= APPOINTMENTS =================


    def appointments(self):

        self.clear()


        patient=ctk.CTkEntry(
            self.main,
            placeholder_text="Patient"
        )

        doctor=ctk.CTkEntry(
            self.main,
            placeholder_text="Doctor"
        )

        date=ctk.CTkEntry(
            self.main,
            placeholder_text="Date"
        )


        for e in [patient,doctor,date]:
            e.pack(pady=5)



        def save():

            cursor.execute(
                """
                INSERT INTO appointments
                VALUES(NULL,?,?,?)
                """,
                (
                    patient.get(),
                    doctor.get(),
                    date.get()
                )
            )

            conn.commit()


            messagebox.showinfo(
                "Saved",
                "Appointment Added"
            )


        ctk.CTkButton(
            self.main,
            text="Save",
            command=save
        ).pack()



    def reports(self):

        self.clear()

        cursor.execute(
            "SELECT COUNT(*) FROM patients"
        )

        patients=cursor.fetchone()[0]


        ctk.CTkLabel(
            self.main,
            text=f"Total Patients: {patients}",
            font=("Arial",25)
        ).pack(pady=30)



    def clear(self):

        for widget in self.main.winfo_children():

            widget.destroy()



